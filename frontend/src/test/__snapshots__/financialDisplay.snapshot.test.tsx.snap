        class="streak-stat"
        data-testid="current-streak"
      >
        <span
          class="streak-stat-value"
        >
          0
        </span>
        <span
          class="streak-stat-label"
        >
          Current Streak
        </span>
      </div>
      <div
        class="streak-stat"
        data-testid="longest-streak"
      >
        <span
          class="streak-stat-value"
        >
          0
        </span>
        <span
          class="streak-stat-label"
        >
          Longest Streak
        </span>
      </div>
    </div>
    <div
      class="streak-progress"
      data-testid="streak-progress"
    >
      <div
        class="streak-progress-header"
      >
        <span>
          Next: 
          🌱
           
          Starter
           (
          5
          )
        </span>
        <span
          class="streak-progress-pct"
        >
          0
          %
        </span>
      </div>
      <div
        aria-label="Progress to Starter badge"
        aria-valuemax="5"
        aria-valuemin="0"
        aria-valuenow="0"
        class="streak-progress-bar"
        role="progressbar"
      >
        <div
          class="streak-progress-fill"
          style="width: 0%;"
        />
      </div>
      <span
        class="streak-progress-sub"
      >
        0
         / 
        5
         contributions
      </span>
    </div>
    <p
      class="streak-no-badges"
      data-testid="no-badges"
    >
      Keep contributing to earn your first badge at 5 contributions!
    </p>
  </div>
</div>
`;

