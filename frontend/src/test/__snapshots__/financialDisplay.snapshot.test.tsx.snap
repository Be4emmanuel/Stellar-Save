exports[`GroupMetrics snapshots > renders completion rate, average time, and health score 1`] = `
<div>
  <div
    class="card card-elevated group-metrics "
  >
    <div
      class="card-body"
    >
      <div
        class="group-metrics-header"
      >
        <h4>
          Performance Metrics
        </h4>
      </div>
      <div
        class="group-metrics-grid"
      >
        <div
          class="group-metric-item"
        >
          <div
            class="group-metric-label"
          >
            Contribution Completion Rate
          </div>
          <div
            class="group-metric-value"
            data-testid="completion-rate-value"
          >
            75
            %
          </div>
          <div
            class="group-metric-trend group-metric-trend-improving"
          >
            Improving
          </div>
        </div>
        <div
          class="group-metric-item"
        >
          <div
            class="group-metric-label"
          >
            Average Contribution Time
          </div>
          <div
            class="group-metric-value"
            data-testid="average-time-value"
          >
            1.0 days
          </div>
          <div
            class="group-metric-trend group-metric-trend-improving"
          >
            Improving
          </div>
        </div>
        <div
          class="group-metric-item"
        >
          <div
            class="group-metric-label"
          >
            Group Health Score
          </div>
          <div
            class="group-metric-value"
            data-testid="health-score-value"
          >
            79
            /100
          </div>
          <div
            class="group-metric-trend group-metric-trend-improving"
          >
            Improving
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
`;

