exports[`MemberCard snapshots > renders a member who has already been paid 1`] = `
<div>
  <div
    class="bg-white rounded-2xl border shadow-sm overflow-hidden transition-all duration-200 border-gray-100 hover:shadow-md "
  >
    <div
      class="relative bg-gradient-to-r from-indigo-50 to-purple-50 px-5 pt-5 pb-10"
    >
      <div
        class="absolute top-4 right-4"
      >
        <span
          class="text-xs font-semibold px-2.5 py-1 rounded-full bg-gray-100 text-gray-500"
        >
          Inactive
        </span>
      </div>
    </div>
    <div
      class="flex justify-center -mt-8 mb-3"
    >
      <div
        class="w-16 h-16 rounded-full border-4 border-white shadow flex items-center justify-center text-white text-xl font-bold bg-orange-500"
      >
        GR
      </div>
    </div>
    <div
      class="text-center px-5 mb-4"
    >
      <h3
        class="font-bold text-gray-900 text-base"
      >
        Grace Hopper
      </h3>
      <div
        class="flex items-center justify-center gap-1 mt-0.5"
      >
        <p
          class="text-sm text-gray-500 font-mono"
        >
          GAX7BQ...6E8F
        </p>
        <button
          class="text-gray-400 hover:text-indigo-500 transition-colors"
          title="Copy address"
        >
          <svg
            class="w-3.5 h-3.5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
            />
          </svg>
        </button>
      </div>
      <p
        class="text-xs text-gray-400 mt-1"
      >
        Joined 
        Feb 14, 2026
      </p>
    </div>
    <div
      class="border-t border-gray-100 mx-5"
    />
    <div
      class="grid grid-cols-3 gap-2 px-5 py-4"
    >
      <div
        class="text-center"
      >
        <p
          class="text-lg font-bold text-gray-900"
        >
          8
        </p>
        <p
          class="text-xs text-gray-500"
        >
          Contributions
        </p>
      </div>
      <div
        class="text-center"
      >
        <p
          class="text-lg font-bold text-gray-900"
        >
          4000 XLM
        </p>
        <p
          class="text-xs text-gray-500"
        >
          Total Paid
        </p>
      </div>
      <div
        class="text-center"
      >
        <p
          class="text-lg font-bold text-gray-900"
        >
          1st
        </p>
        <p
          class="text-xs text-gray-500"
        >
          Payout Position
        </p>
        <p
          class="text-xs text-indigo-500"
        >
          Received
        </p>
      </div>
    </div>
    <div
      class="px-5 pb-4"
    >
      <div
        class="flex justify-between text-xs text-gray-400 mb-1"
      >
        <span>
          Payout queue
        </span>
        <span>
          1
           / 
          10
        </span>
      </div>
      <div
        class="w-full bg-gray-100 rounded-full h-1.5"
      >
        <div
          class="h-1.5 rounded-full transition-all bg-green-400"
          style="width: 10%;"
        />
      </div>
    </div>
  </div>
</div>
`;

